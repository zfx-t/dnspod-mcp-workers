# Copy to .dev.vars for local `wrangler dev` (never commit real secrets)

TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxx
TENCENTCLOUD_REGION=ap-guangzhou

# Password shown on the OAuth authorize page (Grok / Claude browser login)
OAUTH_PASSWORD=change-me-to-a-long-random-string

# HMAC secret for signing JWT access tokens
OAUTH_JWT_SECRET=change-me-to-another-long-random-string
